{
  "name": "portfolio-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-resume-pdf.mjs && node scripts/check-resume-docx.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-placeholders.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check:mobile": "node scripts/check-sidebar-redistribution.mjs && node scripts/check-print-rules.mjs && node scripts/check-mobile-palette-css.mjs",
    "test:contrast": "playwright test"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@next/eslint-plugin-next": "15.5.15",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.15.17",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.15",
    "jsdom": "26.1.0",
    "knip": "^6.11.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.59.1",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
